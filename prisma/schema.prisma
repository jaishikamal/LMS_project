// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       String @id
  username String @unique
  password String
}

model Student {
  id          String       @id
  username    String       @unique
  password    String
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String
  parent      Parent       @relation(fields: [parentId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances Attendance[]
  results     Result[]
  guardians   Guardian[]
  invoices    Invoice[]
  birthday    DateTime
}

model Guardian {
  id           Int     @id @default(autoincrement())
  name         String
  relationship String
  phone        String?
  email        String?
  isPrimary    Boolean @default(false)
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Teacher {
  id           String         @id
  username     String         @unique
  password     String
  name         String
  surname      String
  email        String?        @unique
  phone        String?        @unique
  address      String
  img          String?
  bloodType    String
  sex          UserSex
  createdAt    DateTime       @default(now())
  subjects     Subject[]
  classes      Class[]
  classSubjects ClassSubject[]
  lessons      Lesson[]
  logbook      LogbookEntry[]
  salaries     SalaryRecord[]
  birthday     DateTime
}

model Parent {
  id        String    @id
  username  String    @unique
  password  String
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Grade {
  id    Int @id @default(autoincrement())
  level Int @unique

  students Student[]
  classes  Class[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])
  classSubjects ClassSubject[]
  slots         TimetableSlot[]
  feeItems      FeeItem[]
  events        Event[]
  announcements Announcement[]
}

model Subject {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  teachers     Teacher[]
  classSubjects ClassSubject[]
}

// One subject taught to one class by one teacher. Exams, assignments and
// attendance all hang off a ClassSubject, so a teacher's scope is exactly the
// subjects they teach, and a student's daily attendance is per subject.
model ClassSubject {
  id        Int      @id @default(autoincrement())
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  exams       Exam[]
  assignments Assignment[]
  attendance  Attendance[]
  lessons     Lesson[]
  logbook     LogbookEntry[]
  timetableSlots TimetableSlot[]

  @@unique([classId, subjectId])
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  classSubjectId Int
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  results        Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  classSubjectId Int
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  results        Result[]
}

model Result {
  id    Int @id @default(autoincrement())
  score Int

  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  classSubjectId Int
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])

  @@unique([classSubjectId, studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

// Timetable: reusable period timeslots, and one scheduled subject per
// (class, day, period) cell. The same grid can be copied to another class.
model Period {
  id        Int      @id @default(autoincrement())
  name      String
  startTime DateTime
  endTime   DateTime
  order     Int

  slots TimetableSlot[]
}

model TimetableSlot {
  id             Int           @id @default(autoincrement())
  classId        Int
  class          Class         @relation(fields: [classId], references: [id])
  // 1 = Monday ... 5 = Friday
  dayOfWeek      Int
  periodId       Int
  period         Period        @relation(fields: [periodId], references: [id])
  classSubjectId Int?
  classSubject   ClassSubject? @relation(fields: [classSubjectId], references: [id])

  @@unique([classId, dayOfWeek, periodId])
}

model Lesson {
  id             Int          @id @default(autoincrement())
  title          String
  topic          String?
  objectives     String?
  materials      String?
  notes          String?
  startDate      DateTime
  endDate        DateTime?
  classSubjectId Int
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
}

model LogbookEntry {
  id             Int          @id @default(autoincrement())
  date           DateTime
  topic          String
  summary        String
  homework       String?
  notes          String?
  classSubjectId Int
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
}

// Non-teaching staff (managed by admins; not login accounts).
model Staff {
  id          String   @id
  name        String
  surname     String
  email       String?  @unique
  phone       String?  @unique
  address     String
  role        String // e.g. Accountant, Librarian, Nurse
  department  String
  joinDate    DateTime
  birthday    DateTime?
  sex         UserSex?
  img         String?
  createdAt   DateTime @default(now())

  attendance  StaffAttendance[]
  performance StaffPerformance[]
  salaries    SalaryRecord[]
}

model StaffAttendance {
  id        Int      @id @default(autoincrement())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean
  status    String // Present, Absent, Leave

  @@unique([staffId, date])
}

model StaffPerformance {
  id         Int      @id @default(autoincrement())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reviewDate DateTime
  rating     Int // 1-5
  comments   String?

  @@index([staffId])
}

// FEE ITEM — a chargeable fee (e.g. Tuition, Exam Fee). Optionally class-specific.
model FeeItem {
  id       Int      @id @default(autoincrement())
  name     String
  amount   Decimal  @db.Decimal(10, 2)
  classId  Int?
  class    Class?   @relation(fields: [classId], references: [id])
  invoices Invoice[]

  @@index([classId])
}

model Invoice {
  id        Int      @id @default(autoincrement())
  invoiceNo String   @unique
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  feeItemId Int
  feeItem   FeeItem  @relation(fields: [feeItemId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  dueDate   DateTime
  status    String   @default("Unpaid") // Unpaid | Partial | Paid
  issuedAt  DateTime @default(now())
  payments  Payment[]

  @@index([studentId])
  @@index([status])
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  method    String // Cash, Bank Transfer, Card, Mobile
  date      DateTime
  reference String?

  @@index([invoiceId])
}

// Monthly salary record for a staff member or a teacher.
model SalaryRecord {
  id            Int      @id @default(autoincrement())
  recipientType String // "Staff" | "Teacher"
  staffId       String?
  staff         Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month         DateTime // first day of the month
  amount        Decimal  @db.Decimal(10, 2)
  paid          Boolean  @default(false)
  paidDate      DateTime?
  notes         String?

  @@index([month])
}

model Expense {
  id       Int      @id @default(autoincrement())
  title    String
  category String
  amount   Decimal  @db.Decimal(10, 2)
  date     DateTime
  notes    String?
}

// A school-wide broadcast aimed at one role. Per-user read state lives in
// NotificationRead, so admins publish once and each recipient marks their own.
model Notification {
  id        Int       @id @default(autoincrement())
  title     String
  message   String
  role      String // admin | teacher | student | parent
  createdAt DateTime  @default(now())
  reads     NotificationRead[]

  @@index([role])
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}

// One-to-one internal messages between any two login accounts. The sender and
// recipient are identified by their table id + role (e.g. teacher5/student3),
// because the accounts live in separate tables keyed by string ids.
model Message {
  id            Int       @id @default(autoincrement())
  senderId      String
  senderRole    String // admin | teacher | student | parent
  recipientId   String
  recipientRole String // admin | teacher | student | parent
  subject       String
  body          String
  sentAt        DateTime  @default(now())
  readAt        DateTime?

  @@index([recipientId])
  @@index([senderId])
}

// A stockable item in the school inventory (books, supplies, equipment).
model InventoryItem {
  id          Int      @id @default(autoincrement())
  name        String
  category    String // Books | Supplies | Equipment
  quantity    Int
  location    String?
  description String?
  createdAt   DateTime @default(now())

  issues InventoryIssue[]

  @@index([category])
}

// A single issue/return of an inventory item to a borrower.
model InventoryIssue {
  id           Int            @id @default(autoincrement())
  itemId       Int
  item         InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrowerType String // Student | Teacher | Staff
  borrowerName String
  issuedDate   DateTime
  dueDate      DateTime
  returnedDate DateTime?
  notes        String?

  @@index([itemId])
  @@index([returnedDate])
}

// Key/value school configuration, e.g. schoolName, motto, address, phone,
// email, academicYear. One row per key; read anywhere, edited by admins.
model Setting {
  key   String @id
  value String
}

// Immutable trail of who changed what and when. Kept compact on purpose:
// every entry records the actor, the record type and the affected row id.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   String
  actorRole String // admin | teacher | student | parent
  action    String // create | update | delete
  entity    String // e.g. Student, Invoice
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([actorId])
}

// Catalog of named capabilities (e.g. students.manage, invoice.view). One row
// per permission key; the human-readable label drives the permissions UI.
model Permission {
  key      String           @id
  label    String
  category String // e.g. Students, Finance, System
  roles    RolePermission[]
}

// Permission-to-role assignments. The RBAC controller edits these rows; the
// sidebar menu and every server guard resolve access through them.
model RolePermission {
  role          String // admin | teacher | student | parent
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@index([permissionKey])
}

// Role group chat: a room is either open to every role ("global") or to a
// single role ("role" + `role`). Messages are stored so history survives
// reloads; delivery is real-time via Socket.IO.
model ChatRoom {
  id        Int           @id @default(autoincrement())
  name      String
  // "global" = open to all roles, "role" = open only to `role`
  type      String        @default("role")
  role      String?
  createdAt DateTime      @default(now())

  messages ChatMessage[]
  reads    ChatReadState[]
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  roomId     Int
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole String // admin | teacher | student | parent
  senderName String
  body       String
  // "message" = normal post (replyable), "announcement" = broadcast (not replyable)
  kind       String   @default("message")
  createdAt  DateTime @default(now())

  @@index([roomId])
}

// Tracks when a user last read a room, so the room list can show unread counts.
model ChatReadState {
  id          Int      @id @default(autoincrement())
  roomId      Int
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  lastReadAt  DateTime @default(now())

  @@unique([roomId, userId])
}

enum UserSex {
  MALE
  FEMALE
}
